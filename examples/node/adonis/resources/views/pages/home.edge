@layout()
  <div class="hero">
    <h1>It works — welcome to the simplicity of a Hypermedia app</h1>
    <p>A lightweight foundation for building modern web interfaces — straightforward, flexible, and true to the web's core simplicity.</p>
  </div>

  <div class="cards">
    <a href="https://insiders.adonisjs.com/docs/v7-alpha/introduction" target="_blank">
      <h3>Official Docs &nbsp;›</h3>
      <p>Comprehensive reference for building with AdonisJS</p>
    </a>

    <a href="https://adocasts.com/" target="_blank">
      <h3>Adocasts &nbsp;›</h3>
      <p>Guided video tutorials for everyday development</p>
    </a>

    <a href="https://discord.gg/vDcEjq6" target="_blank">
      <h3>Discord &nbsp;›</h3>
      <p>Connect with developers building with AdonisJS every day</p>
    </a>
  </div>

  <div style="margin-top: 2rem; padding: 1.5rem; border: 1px solid #333; border-radius: 8px;">
    <h3>Debugger Test Panel</h3>
    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 1rem;">
      <button onclick="fetch('/api/test').then(r=>r.json()).then(d=>document.getElementById('result').textContent=JSON.stringify(d))">GET /api/test</button>
      <button onclick="fetch('/api/test?error=true').then(r=>r.json()).then(d=>document.getElementById('result').textContent=JSON.stringify(d))">GET /api/test (error)</button>
      <button onclick="fetch('/api/users').then(r=>r.json()).then(d=>document.getElementById('result').textContent=JSON.stringify(d))">GET /api/users</button>
      <button onclick="console.log('browser log', Date.now())">console.log</button>
      <button onclick="console.warn('browser warn', Date.now())">console.warn</button>
      <button onclick="console.error('browser error', Date.now())">console.error</button>
    </div>
    <pre id="result" style="margin-top: 1rem; padding: 0.75rem; background: #1a1a1a; border-radius: 4px; min-height: 2rem; overflow-x: auto;"></pre>
  </div>
@end
