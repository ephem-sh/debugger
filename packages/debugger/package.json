{
  "name": "@ephem-sh/debugger",
  "version": "0.3.3",
  "type": "module",
  "bin": {
    "dbg": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./nextjs": {
      "edge-light": "./dist/adapters/nextjs/noop.js",
      "types": "./dist/adapters/nextjs/index.d.ts",
      "import": "./dist/adapters/nextjs/index.js"
    },
    "./nextjs/script": {
      "edge-light": "./dist/adapters/nextjs/noop.js",
      "types": "./dist/adapters/nextjs/script.d.ts",
      "import": "./dist/adapters/nextjs/script.js"
    },
    "./vite": {
      "types": "./dist/adapters/vite/index.d.ts",
      "import": "./dist/adapters/vite/index.js"
    },
    "./vite/sveltekit": {
      "types": "./dist/adapters/vite/sveltekit.d.ts",
      "import": "./dist/adapters/vite/sveltekit.js"
    },
    "./vite/react-router": {
      "types": "./dist/adapters/vite/react-router.d.ts",
      "import": "./dist/adapters/vite/react-router.js"
    },
    "./vite/astro": {
      "types": "./dist/adapters/vite/astro.d.ts",
      "import": "./dist/adapters/vite/astro.js"
    },
    "./vite/tanstack-start": {
      "types": "./dist/adapters/vite/tanstack-start.d.ts",
      "import": "./dist/adapters/vite/tanstack-start.js"
    },
    "./vite/nuxt": {
      "types": "./dist/adapters/vite/nuxt.d.ts",
      "import": "./dist/adapters/vite/nuxt.js"
    },
    "./nitro": {
      "types": "./dist/adapters/nitro/index.d.ts",
      "import": "./dist/adapters/nitro/index.js"
    },
    "./angular": {
      "types": "./dist/adapters/angular/index.d.ts",
      "import": "./dist/adapters/angular/index.js"
    },
    "./express": {
      "types": "./dist/adapters/express/index.d.ts",
      "import": "./dist/adapters/express/index.js"
    },
    "./hono": {
      "types": "./dist/adapters/hono/index.d.ts",
      "import": "./dist/adapters/hono/index.js"
    },
    "./elysia": {
      "types": "./dist/adapters/elysia/index.d.ts",
      "import": "./dist/adapters/elysia/index.js"
    },
    "./fastify": {
      "types": "./dist/adapters/fastify/index.d.ts",
      "import": "./dist/adapters/fastify/index.js"
    },
    "./nest": {
      "types": "./dist/adapters/nest/index.d.ts",
      "import": "./dist/adapters/nest/index.js"
    },
    "./adonis": {
      "types": "./dist/adapters/adonis/index.d.ts",
      "import": "./dist/adapters/adonis/index.js"
    }
  },
  "homepage": "https://debugger.ephem.sh/",
  "repository": {
    "type": "git",
    "url": "https://github.com/ephem-sh/debugger"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && bun build src/browser/client.ts --outdir dist/browser --target browser --format iife",
    "build:types": "tsc",
    "build:browser": "bun build src/browser/client.ts --outdir dist/browser --target browser --format iife",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "next": ">=14",
    "react": ">=18",
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19",
    "typescript": "^5",
    "vite": "^6"
  }
}
