{
  "name": "debuger",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "bun run --cwd packages/debugger build",
    "typecheck": "bun run --cwd packages/debugger typecheck",
    "dev:nextjs": "bun run --cwd examples/nextjs dev",
    "changelog": "conventional-changelog -p conventionalcommits -i CHANGELOG.md -s"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "conventional-changelog-cli": "^5.0.0"
  }
}
