{
  "name": "debuger",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --cwd packages/debugger build",
    "typecheck": "bun run --cwd packages/debugger typecheck",
    "changelog": "conventional-changelog -p conventionalcommits -i CHANGELOG.md -s",
    "example": "bun run scripts/example.ts",
    "install:example": "bun run scripts/example.ts install",
    "dev:example": "bun run scripts/example.ts dev",
    "examples": "bun run scripts/example.ts list"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "conventional-changelog-cli": "^5.0.0"
  }
}
